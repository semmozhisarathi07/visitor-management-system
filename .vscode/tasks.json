{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Visitor Management System",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["javafx:run"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Starts the JavaFX application (requires MySQL to be running)"
        },
        {
            "label": "Compile Project",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["compile"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$javac"],
            "detail": "Compiles the Java code without starting the UI"
        }
    ]
}
